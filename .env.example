# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Live start only. A build that is not a demo creates one owner from these on first run.
OWNER_PHONE=
OWNER_PIN=
# Set to 1 when BUILDING a production demo, to show sample sign-ins on the login page. Leave empty for a live shop.
NEXT_PUBLIC_BREADPOS_DEMO=

# Server only. Signs staff sessions; required for `npm run build` + `npm start`.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Domains. Leave all of these empty to run every app on one address (local development).
# When set, each domain serves only its own apps, and the one login lives on AUTH_ORIGIN.
# All of them must use the same SESSION_SECRET, and all must share one database (Supabase stage).
AUTH_ORIGIN=            # https://auth.niro.cards      the single login
BREAD_ORIGIN=           # https://bread.niro.cards     POS, Kitchen, Manager, Items
WORKFORCE_ORIGIN=       # https://workforce.niro.cards Captain
ADMIN_ORIGIN=           # https://admin.outpulse.company  POS Admin
CUSTOMER_ORIGIN=        # https://niro.cards           customer ordering: /o/{outlet}/{table}, /api/orders/{outlet}/{table}
